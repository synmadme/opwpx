diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
index 92fd10a04f..4c6d9d50a0 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
@@ -49,6 +49,7 @@ case "$FIRMWARE" in
 	xiaomi,ax6000)
 		caldata_extract "0:art" 0x1000 0x20000
 		;;
+        liteon,wpx8324|\
 	yuncore,ax830|\
 	yuncore,ax850)
 		caldata_extract "0:ART" 0x1000 0x20000
@@ -95,6 +96,13 @@ case "$FIRMWARE" in
 		ath11k_remove_regdomain
 		ath11k_set_macflag
 		;;
+        liteon,wpx8324)
+                dd if=/dev/mtd16 of=/tmp/caldata.bin bs=1 skip=$((0x26800)) count=$((0x20000)) 2>/dev/null
                 caldata_from_file /tmp/caldata.bin "$FIRMWARE" 2>/dev/null
                 rm -f /tmp/caldata.bin
+                label_mac=$(dd if=/dev/mtd16 bs=1 skip=0 count=6 2>/dev/null | hexdump -v -e '5/1 "%02x:" 1/1 "%02x"')
+                ath11k_patch_mac $(macaddr_add $label_mac 3) 0
+                ath11k_remove_regdomain
