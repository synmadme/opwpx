From 9b5569037d7d694658c981756d0fea51da82ca9c Mon Sep 17 00:00:00 2001
From: Andi Rijal Habibi <isibondt@gmail.com>
Date: Thu, 6 Aug 2026 01:04:44 +0700
Subject: [PATCH] qualcommax: ipq50xx: add support for Lite-On WPX8324

Add support for Lite-On WPX8324 Indoor Access Point / Mesh AP.

Specifications:
- SoC: Qualcomm IPQ5018
- Wi-Fi: 802.11ax (AX3000), 2x2 2.4 GHz, 2x2 5 GHz
- Installation: Boot initramfs via TFTP, then sysupgrade via LuCI.

Reference: https://fccid.io/PPQ-WPX8324

Signed-off-by: Andi Rijal Habibi <isibondt@gmail.com>
Signed-off-by: gamblingaddict <112048350+gamblingaddict@users.noreply.github.com>
---
 .../uboot-envtools/files/qualcommax_ipq50xx   |   1 +
 package/firmware/ipq-wifi/Makefile            |   2 +
 .../ipq-wifi/src/board-liteon_wpx8324.ipq5018 | Bin 0 -> 131180 bytes
 .../ipq-wifi/src/board-liteon_wpx8324.qcn6122 | Bin 0 -> 131180 bytes
 .../arm64/boot/dts/qcom/ipq5018-wpx8324.dts   | 406 ++++++++++++++++++
 target/linux/qualcommax/image/ipq50xx.mk      |  19 +
 .../ipq50xx/base-files/etc/board.d/02_network |   1 +
 .../etc/hotplug.d/firmware/11-ath11k-caldata  |   8 +
 .../base-files/lib/upgrade/platform.sh        |   1 +
 9 files changed, 438 insertions(+)
 create mode 100644 package/firmware/ipq-wifi/src/board-liteon_wpx8324.ipq5018
 create mode 100644 package/firmware/ipq-wifi/src/board-liteon_wpx8324.qcn6122
 create mode 100644 target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-wpx8324.dts

diff --git a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
index d825f885dd..2d7c403bba 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
+++ b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq50xx
@@ -29,6 +29,7 @@ xiaomi,ax6000)
 	ubootenv_add_mtd "0:appsblenv" "0x0" "0x10000" "0x20000"
 	ubootenv_add_sys_mtd "bdata" "0x0" "0x10000" "0x20000"
 	;;
+liteon,wpx8324|\
 yuncore,ax830|\
 yuncore,ax850)
 	ubootenv_add_mtd "0:APPSBLENV" "0x0" "0x10000" "0x10000"
diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index d3605dd622..6951170ac1 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -61,6 +61,7 @@ ALLWIFIBOARDS:= \
 	linksys_mx8500 \
 	linksys_spnmx56 \
 	linksys_whw03 \
+	liteon_wpx8324 \
 	meraki_mr30h \
 	meraki_z3 \
 	netgear_lbr20 \
@@ -246,6 +247,7 @@ $(eval $(call generate-ipq-wifi-package,linksys_mx6200,Linksys MX6200))
 $(eval $(call generate-ipq-wifi-package,linksys_mx8500,Linksys MX8500))
 $(eval $(call generate-ipq-wifi-package,linksys_spnmx56,Linksys SPNMX56))
 $(eval $(call generate-ipq-wifi-package,linksys_whw03,Linksys WHW03))
+$(eval $(call generate-ipq-wifi-package,liteon_wpx8324,Lite-On WPX8324))
 $(eval $(call generate-ipq-wifi-package,meraki_mr30h,Meraki MR30H))
 $(eval $(call generate-ipq-wifi-package,meraki_z3,Meraki Z3))
 $(eval $(call generate-ipq-wifi-package,netgear_lbr20,Netgear LBR20))
